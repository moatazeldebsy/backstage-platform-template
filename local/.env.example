# Copy to .env and fill in values before running local scripts.
# Shared settings used by bootstrap scripts and tooling.
# Backstage-specific tokens (OAuth, K8s) go in local/backstage/.env.

# ── Platform identity (written by setup.sh — do not edit manually) ──────────
GITHUB_ORG=moatazeldebsy
PLATFORM_REPO=backstage-platform-template_NAME

# ── GitHub Personal Access Token (PAT) ──────────────────────────────────────
# Required for:
#   - Scaffolder templates to create/push repositories on your behalf
#   - DORA metrics exporter to read commit/PR data
#   - Catalog import from GitHub
#
# Create at: https://github.com/settings/tokens
#   Token type : Classic
#   Required scopes: repo, read:org, workflow, delete_repo
#   Expiry: set to at least 90 days (or "No expiration" for local dev)
GITHUB_TOKEN=ghp_YOUR_GITHUB_PAT

# ── AWS credentials (only needed for TechDocs S3 or ECR pushes) ─────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Local Kind cluster name (default matches setup.sh) ──────────────────────
CLUSTER_NAME=idp-mvp

# ── Local Kubernetes provider ────────────────────────────────────────────────
# kind            — default; requires Kind binary
# rancher-desktop — uses the running Rancher Desktop k3s cluster
KUBERNETES_PROVIDER=kind

# ── Anthropic Claude API (used by KAgent IDP assistant) ─────────────────────
# Required for AI agents — powers the KAgent IDP assistant (Claude Haiku).
# Create at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY

# ── OpenAI API (not required — platform runs fully on Anthropic) ──────────────
# Leave unset unless you specifically want to evaluate GPT-4o agents alongside Claude.
# When set, bootstrap-ai.sh creates the kagent-openai secret and applies
# kubernetes/kagent/modelconfig-openai.yaml. Has no effect otherwise.
# Create at: https://platform.openai.com/account/api-keys
# OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY

# ── Slack notifications (optional) ──────────────────────────────────────────
# Enables AlertManager → Slack routing for platform alerts.
# Create an Incoming Webhook at https://api.slack.com/apps → Your App → Incoming Webhooks

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ── PagerDuty on-call paging (optional) ─────────────────────────────────────
# Enables AlertManager → PagerDuty for critical alerts (pages on-call engineer).
# Get the integration key from PagerDuty:
#   Service → Integrations → Add Integration → Events API v2 → copy "Integration Key"
# PAGERDUTY_INTEGRATION_KEY=your-pagerduty-integration-key

# ── AI Stack — Sprint 3/4 MCP servers (required if using bootstrap-ai.sh) ───
# These are read by bootstrap-ai.sh to create Kubernetes secrets in services-dev.

# ArgoCD token for argocd-mcp-server (list/sync/rollback ArgoCD apps).
# Use the dedicated argocd-mcp account, NOT admin. It is declared apiKey-only in
# local/argocd/argocd-helm-values-local.yaml and scoped to get + sync + action/*
# on applications, so a leaked token cannot create or delete Applications.
# Generate: argocd account generate-token --account argocd-mcp
# (Logging in first needs the initial admin password:
#  kubectl -n argocd get secret argocd-initial-admin-secret \
#    -o jsonpath='{.data.password}' | base64 -d)
# ARGOCD_TOKEN=

# GitHub webhook secret — must match the "Secret" you set in GitHub → Repo → Settings →
# Webhooks when configuring the agent-event-router webhook receiver.
# Generate a random value: openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=

# Bearer token for the AlertManager and ArgoCD webhook endpoints on agent-event-router.
# Optional locally (in-cluster callers only); required in AWS.
# Generate a random value: openssl rand -hex 32
# WEBHOOK_TOKEN=

# ── GitHub App (replaces GH_PAT for auto-merge CI and Backstage scaffolder) ──
# Preferred over a PAT: higher rate limits, no expiry, per-installation tokens.
# Setup: github.com/settings/apps → New GitHub App
#   Permissions: Contents=Read, Pull requests=Write, Members=Read, Metadata=Read
# Add repo secrets APP_ID and APP_PRIVATE_KEY in GitHub Actions.
# For Backstage (production), set the 5 keys below in AWS Secrets Manager.
# For local dev, these are optional — GITHUB_TOKEN (PAT) is still used locally.
#
# GITHUB_APP_ID=123456
# GITHUB_APP_CLIENT_ID=Iv1.abc123
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
# GITHUB_APP_WEBHOOK_SECRET=

# ── DORA Metrics — Team Map (optional, AWS/production only) ──────────────────
# Maps service repo names to team names for per-team DORA metric aggregation.
# Alternative: tag repos with a GitHub topic "team:<name>" (auto-detected).
# Example: TEAM_MAP='{"orders-service":"payments","auth-api":"platform"}'
# TEAM_MAP=
