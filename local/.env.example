# Copy to .env and fill in values before running local scripts
# Shared local-environment settings used by bootstrap scripts and tooling.
# Backstage-specific tokens go in local/backstage/.env (separate file).

# GitHub personal access token — needed by scaffolder templates and catalog import
GITHUB_TOKEN=

# AWS credentials (only needed for TechDocs S3 publishing or ECR pushes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Local Kind cluster name (default matches setup.sh)
CLUSTER_NAME=idp-mvp
