# Copy to .env and fill in values before running docker compose.
# Run setup.sh or ./scripts/get-k8s-credentials.sh to auto-populate K8s vars.

# ── GitHub Personal Access Token (PAT) ──────────────────────────────────────
# Same token as local/.env — needed by scaffolder templates and catalog import.
# Create at: https://github.com/settings/tokens
#   Token type : Classic
#   Required scopes: repo, read:org, workflow, delete_repo
GITHUB_TOKEN=ghp_YOUR_GITHUB_PAT

# ── Security scanning tokens (optional) ──────────────────────────────────────
# When set, the scaffolder auto-injects these as GitHub Actions secrets on every
# new service repo, so the CI workflow's SonarCloud + Snyk steps run on the first
# push instead of silently skipping. Leave blank to opt out — CI stays green either way.
# SonarCloud: https://sonarcloud.io/account/security  (User Token)
# Snyk:       https://app.snyk.io/account             (Auth Token)
SONAR_TOKEN=
SNYK_TOKEN=

# ── GitHub OAuth App ─────────────────────────────────────────────────────────
# Enables "Sign in with GitHub" on the Backstage login screen.
# Without this, only Guest mode works.
#
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Application name : IDP Dev Portal (local)
#   Homepage URL     : http://backstage.idp.local
#   Callback URL     : http://backstage.idp.local/api/auth/github/handler/frame
#
# After creating, copy the Client ID here and generate a Client Secret:
AUTH_GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
AUTH_GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET


# ── Backstage auth secret ─────────────────────────────────────────────────────
# Used by the Backstage token service to sign session cookies (required in v1.29+).
# For local dev any non-empty string works; leave blank to use the built-in default.
# In production use a cryptographically random 32-byte hex string:
#   openssl rand -hex 32
BACKSTAGE_AUTH_SECRET=

# ── K8s plugin ───────────────────────────────────────────────────────────────
# Auto-populated by scripts/get-k8s-credentials.sh — do NOT set manually.
K8S_CLUSTER_URL=
K8S_SERVICE_ACCOUNT_TOKEN=
K8S_CLUSTER_CA_DATA=

# ── ArgoCD ───────────────────────────────────────────────────────────────────
# Auto-populated by bootstrap-local.sh — ArgoCD initial admin password.
ARGOCD_AUTH_TOKEN=

# ── Grafana ───────────────────────────────────────────────────────────────────
# Auto-populated by bootstrap-local.sh — Grafana Viewer service account token.
GRAFANA_TOKEN=

# ── RAG / AI Search ──────────────────────────────────────────────────────────
# Voyage AI embedding API key — Anthropic's recommended embedding partner.
# Sign up at https://www.voyageai.com (free tier: 200M tokens/month).
# Without this, the /ai-search page will return HTTP 503.
VOYAGE_API_KEY=

# ── Security scanning (SonarCloud + Snyk) ───────────────────────────────────
# Used by the Backstage Security tab proxy. Leave blank to render the empty
# state — scaffolded CI jobs also skip gracefully when these are empty.
# Generate tokens at:
#   https://sonarcloud.io/account/security
#   https://app.snyk.io/account
SONAR_TOKEN=
SNYK_TOKEN=

# ── AWS / TechDocs (only needed if publishing docs to S3) ────────────────────
AWS_REGION=us-east-1
TECHDOCS_S3_BUCKET_NAME=

# ── PagerDuty (on-call & incidents tab) ─────────────────────────────────────
# REST API key from https://your-org.pagerduty.com/api_keys
# Read-only key is sufficient. Without this the On-Call tab shows an empty state.
PAGERDUTY_TOKEN=

# ── Jira (issues tab) ────────────────────────────────────────────────────────
# Base URL of your Jira instance (Cloud or Server).
# JIRA_TOKEN is Base64(email:api_token) — generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-company.atlassian.net
JIRA_TOKEN=

# ── GitHub App credentials (optional — replaces GITHUB_TOKEN for production) ─
# For local dev the PAT (GITHUB_TOKEN) is sufficient.
# For AWS/production, configure these in Secrets Manager (idp-mvp/backstage).
# See docs/github-app-setup.md for step-by-step instructions.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
