# Copy to .env and fill in values before running docker compose
# All values are optional for basic local use

# GitHub integration (enables repo creation from scaffolder templates)
GITHUB_TOKEN=

# GitHub OAuth App (enables login — create at github.com/settings/developers)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# K8s plugin — reads your local Kind cluster (run get-k8s-credentials.sh to populate)
K8S_CLUSTER_URL=
K8S_SERVICE_ACCOUNT_TOKEN=
K8S_CLUSTER_CA_DATA=

# Snyk plugin
SNYK_TOKEN=

# AWS / TechDocs (only needed if publishing docs to S3)
AWS_REGION=us-east-1
TECHDOCS_S3_BUCKET_NAME=
