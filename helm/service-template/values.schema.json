{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "service-template values",
  "description": "Deliberately constrains only the rollout block. Everything else stays open (additionalProperties defaults to true) so this file does not become a second, drifting copy of values.yaml. The rollout block is here because a typo in `strategy` produces a Rollout with no strategy at all, which Argo accepts and then never progresses.",
  "type": "object",
  "properties": {
    "rollout": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "strategy": {
          "type": "string",
          "enum": ["canary", "blueGreen"],
          "description": "canary shifts traffic gradually; blueGreen cuts over in one step."
        },
        "analysis": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "templateName": { "type": "string", "minLength": 1 },
            "clusterScope": { "type": "boolean" },
            "errorRateThreshold": {
              "type": "string",
              "pattern": "^[0-9]*\\.?[0-9]+$",
              "description": "Fraction, not percent. 0.01 = 1%. A string so Helm does not reformat it into scientific notation."
            },
            "latencyThresholdSeconds": {
              "type": "string",
              "pattern": "^[0-9]*\\.?[0-9]+$"
            }
          }
        },
        "canary": {
          "type": "object",
          "properties": {
            "steps": { "type": "array" },
            "initialWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
            "step1PauseDuration": { "type": "string" },
            "step2PauseDuration": { "type": "string" }
          }
        },
        "blueGreen": {
          "type": "object",
          "properties": {
            "autoPromotionEnabled": { "type": "boolean" },
            "autoPromotionSeconds": { "type": "integer", "minimum": 0 },
            "scaleDownDelaySeconds": { "type": "integer", "minimum": 0 },
            "previewReplicaCount": { "type": ["integer", "null"], "minimum": 0 },
            "prePromotionAnalysis": { "type": "boolean" },
            "postPromotionAnalysis": { "type": "boolean" }
          }
        }
      }
    }
  }
}
