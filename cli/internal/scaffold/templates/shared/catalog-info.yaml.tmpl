apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: <% .Name %>
  description: Auto-scaffolded <% .Type %> service
  annotations:
    # The service lives in the platform repo (services/<% .Name %>/), not a repo of its own.
    github.com/project-slug: <% .GHOrg %>/<% .PlatformRepo %>
    backstage.io/techdocs-ref: dir:.
    # Matches the backstage.io/kubernetes-id label the ArgoCD ApplicationSet sets
    # via backstage.kubernetesId — the release name is <% .Name %>-<env>, so an
    # app.kubernetes.io/instance selector would match nothing.
    backstage.io/kubernetes-id: <% .Name %>
    backstage.io/kubernetes-namespace: <% .Namespace %>
    grafana/alert-label-selector: service=<% .Name %>
    cost-center: "<% .CostCenter %>"
spec:
  type: service
  lifecycle: development
  owner: <% .Owner %>
  system: internal-developer-platform
