replicaCount: 2

image:
  # Replace YOUR_AWS_ACCOUNT_ID with the output of: aws sts get-caller-identity --query Account --output text
  repository: YOUR_AWS_ACCOUNT_ID.dkr.ecr.eu-central-1.amazonaws.com/<% .Name %>
  tag: "latest"
  pullPolicy: IfNotPresent

service:
  port: 80
  targetPort: <% .Port %>

ingress:
  # Disabled by default. An ALB Ingress provisions a dedicated load balancer at
  # ~$16/mo, and most services only ever need in-cluster reachability via
  # <name>.<namespace>.svc.cluster.local. Turn this on when the service really
  # does need to take public traffic -- and read
  # docs/DEPLOYMENT_GUIDE.md#consolidating-albs first if you are adding several.
  enabled: false
  className: "alb"
  annotations:
    alb.ingress.kubernetes.io/healthcheck-path: /healthz
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
  # The chart iterates ingress.hosts[].paths[]. A top-level `paths:` key is
  # silently ignored and `hosts: []` renders an Ingress with NO rules -- an ALB
  # that provisions, bills, and routes nothing. Keep paths nested under a host.
  hosts:
    - host: ""   # match any hostname; reach it on the ALB's own DNS name
      paths:
        - path: /
          pathType: Prefix

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 512Mi

autoscaling:
  enabled: true
  minReplicas: 2
  maxReplicas: 10
  targetCPUUtilizationPercentage: 70

podLabels:
  team: platform-team

# Allow scheduling on Karpenter-managed spot nodes.
tolerations:
  - key: karpenter.sh/disruption
    operator: Exists
    effect: NoSchedule

# Prefer spreading pods across availability zones.
affinity:
  podAntiAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      - labelSelector:
          matchLabels:
            app.kubernetes.io/name: <% .Name %>
        topologyKey: topology.kubernetes.io/zone

env:
  - name: ENVIRONMENT
    value: production
