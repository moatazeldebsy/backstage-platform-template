CLAUDE.md

# Claude Code: ignore local/session state, but ship the committed platform skills
# (.claude/skills/, .claude/agents/, .claude/context/, .claude/settings.json).
# settings.local.json, worktrees/ and scheduled_tasks.lock stay ignored.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/context/
!.claude/settings.json

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/global/.terraform/
terraform/global/.terraform.lock.hcl
terraform/terraform.tfvars
# Generated by scripts/setup.sh — contains your own state bucket and account-scoped
# lock table. Per-install, never shared.
terraform/backend.hcl
terraform/tfplan
terraform/*.tfplan
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/override.tf
terraform/override.tf.json

# Go
services/*/bin/
services/*/*.test
bin/
cli/bin/
cli/idp

# Xcode / Swift build artifacts
.build/

# Node
node_modules/
npm-debug.log*
coverage/
lcov.info

# Python
__pycache__/
*.pyc
.venv/
dist/
*.egg-info/

# Docker
.dockerignore
!backstage/app/.dockerignore

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets / env
.env
.env.*
!.env.example
.idp-config.env

# Locally scaffolded catalog entries (written by idp:catalog-register-local)
backstage/catalog/scaffolded/*/
!backstage/catalog/scaffolded/.gitkeep
*.pem
*.key
kubeconfig

.playwright-cli/
.playwright-mcp/

# MkDocs build output
site/

# macOS Finder / SMB lock-files (e.g. .!12345!handler.zip)
.!*

# Deployment status snapshots and generated URL files (not canonical — use docs/ instead)
AWS_*.md
LOCAL_*.md
LOCAL_VS_AWS_URLS.md
DEMO_*.md
DEMO_*.sh
DEPLOYMENT_*.md
FINAL_*.md
AIML_*.md
SERVICE_URLS.md
PRODUCTION_*.md
SETUP_PRODUCTION_*.md
WORKING_*.txt
LIVE_*.txt
AWS_PUBLIC_URLS.txt
*.log

# Gradle local build cache (generated by running ./gradlew in a scaffold skeleton)
.gradle/

# Local bootstrap-script fingerprint cache (skip-if-unchanged Helm release checks)
.idp-cache/

# Generated Backstage AI-layer overlay — written by bootstrap-local.sh (AI off)
# and bootstrap-ai.sh (AI on). Never hand-edited, never committed.
local/backstage/app-config.ai.yaml

# Lambda deployment packages — generated by terraform archive_file at plan time.
terraform/lambda/*.zip
terraform/lambda/*/handler.zip

# generated diagram builds
docs/diagrams/.build/
