{
  "name": "qa-mcp-server",
  "version": "0.1.1",
  "description": "MCP server exposing QA and testing capabilities as AI tools for KAgent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "lint": "eslint src/",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.19.0",
    "node-fetch": "^3.3.2",
    "prom-client": "^15.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "esbuild": "^0.28.1",
    "hono": "^4.12.27",
    "js-yaml": "^4.2.0",
    "fast-uri": "^3.1.4",
    "@hono/node-server": "^2.0.11"
  }
}
