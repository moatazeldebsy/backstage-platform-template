{
  "name": "approval-service",
  "version": "0.1.0",
  "description": "HiTL approval gate for agent-initiated mutating actions \u2014 Policy-as-Prompt evaluation + human approve/deny workflow",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
