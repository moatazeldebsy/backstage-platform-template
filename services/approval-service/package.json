    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "dependencies": {
    "express": "^4.19.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^30.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "hono": "^4.12.27",
    "js-yaml": "^4.3.1",
    "fast-uri": "^3.1.4",
    "@hono/node-server": "^2.0.11"
