# ── Server ────────────────────────────────────────────────────────────────
PORT=3003

# ── Storage ───────────────────────────────────────────────────────────────
# memory (default, non-persistent) | postgres | dynamodb
STORAGE_TYPE=postgres

# Required when STORAGE_TYPE=postgres
DATABASE_URL=postgresql://contract:contract@localhost:5432/contract_registry

# Required when STORAGE_TYPE=dynamodb
# DYNAMO_TABLE=contract-registry

# ── AWS ───────────────────────────────────────────────────────────────────
# Required when STORAGE_TYPE=dynamodb
AWS_REGION=us-east-1

# AWS credentials — one of:
#   1. Mount ~/.aws into container (docker-compose.standalone.yml does this)
#   2. Set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY below
#   3. Use an IAM role (ECS task role / IRSA on K8s)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default

# ── Service Discovery ─────────────────────────────────────────────────────
# kubernetes (default, in-cluster K8s API) | http | docker
DISCOVERY_MODE=http

# Required when DISCOVERY_MODE=http. Comma-separated name=url pairs.
# Example: payments-api=http://localhost:8080,users-api=http://localhost:8081
SERVICES_REGISTRY=

# ── Notifications ─────────────────────────────────────────────────────────
# POST webhook fired when a provider registers a new version with breaking changes.
# Payload: { provider, from_version, to_version, breaking_changes, affected_consumers }
# Wire to: Slack incoming webhook, GitHub issue creation endpoint, PagerDuty, etc.
BREAKING_CHANGE_WEBHOOK_URL=

# ── Auth ──────────────────────────────────────────────────────────────────
# If set, all write operations (POST /api/contracts/*) require
# X-Api-Key: <this value> header. Read operations remain public.
API_KEY=

# ── Tuning ────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_MS=8000
DISCOVER_PROBE_TIMEOUT_MS=2500
DISCOVER_CONCURRENCY=10
