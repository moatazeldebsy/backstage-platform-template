{
  "name": "${{ values.name }}",
  "version": "0.1.0",
  "description": "${{ values.description }}",
  "private": true,
  "scripts": {
    "test": "jest --testPathPattern=consumer",
    "verify": "jest --testPathPattern=provider",
    "publish": "pact-broker publish ./pacts --consumer-app-version=$(git rev-parse --short HEAD) --broker-base-url=${{ values.pactBrokerUrl }}"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^16.5.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[tj]s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "esModuleInterop": true,
            "module": "commonjs"
          },
          "isolatedModules": true
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(https-proxy-agent|agent-base|proxy-agent-negotiate)/)"
    ]
  },
  "overrides": {
    "js-yaml": "^3.15.2",
    "qs": "^6.16.0"
  }
}
