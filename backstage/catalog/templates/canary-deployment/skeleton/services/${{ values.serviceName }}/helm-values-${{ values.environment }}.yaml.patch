# Argo Rollouts canary patch — merge these values into helm-values-${{ values.environment }}.yaml
# Generated by the 'Enable Canary Deployments' Backstage template.
#
# Add these fields to services/${{ values.serviceName }}/helm-values-${{ values.environment }}.yaml:

rollout:
  enabled: true
  canary:
    initialWeight: ${{ values.initialWeight }}
    step1PauseDuration: "${{ values.step1PauseDuration }}"
    step2PauseDuration: "${{ values.step2PauseDuration }}"

# HPA remains active and will target the Rollout resource automatically.
# PodDisruptionBudget remains active (minAvailable: 1).
