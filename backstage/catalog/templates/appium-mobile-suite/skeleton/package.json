{
  "name": "${{ values.name }}",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "wdio run wdio.config.ts",
    "appium": "appium",
    "appium:drivers": "${{ 'appium driver install xcuitest' if values.platform == 'ios' else ('appium driver install uiautomator2 && appium driver install xcuitest' if values.platform == 'both' else 'appium driver install uiautomator2') }}"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/junit-reporter": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "appium": "^3.6.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.1",
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.20.0",
    "fast-uri": "^3.1.7",
    "js-yaml": "^4.3.2",
    "morgan": "^1.12.1",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.1.0",
    "sharp": "^0.35.5",
    "shell-quote": "^1.11.0"
  }
}
