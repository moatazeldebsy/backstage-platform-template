{
  "title": "AI Platform Observability",
  "uid": "ai-platform",
  "tags": [
    "ai",
    "agents",
    "mcp"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "MCP Tool Calls (Total)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(mcp_tool_calls_total[5m])) or vector(0)",
          "refId": "A",
          "legendFormat": "Tool Calls"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        }
      }
    },
    {
      "id": 4,
      "title": "MCP Tool Call Errors",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(mcp_tool_calls_total{outcome=\"error\"}[5m])) or vector(0)",
          "refId": "A",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        }
      }
    },
    {
      "id": 5,
      "title": "Tool Calls by MCP Server (1h)",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (job) (increase(mcp_tool_calls_total[1h]))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "MCP Tool Calls by Server",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(mcp_tool_calls_total[5m]))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "noValue": "0"
        }
      }
    },
    {
      "id": 3,
      "title": "MCP Tool Latency (P95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum by (job, le) (rate(mcp_tool_duration_seconds_bucket[5m]))) > 0) or (sum by (job) (rate(mcp_tool_calls_total[5m])) * 0)",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          },
          "noValue": "0"
        }
      }
    },
    {
      "id": 6,
      "title": "MCP Tool Latency Distribution (P50/P95/P99)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.50, sum by (job, le) (rate(mcp_tool_duration_seconds_bucket[5m]))) > 0) or (sum by (job) (rate(mcp_tool_calls_total[5m])) * 0)",
          "refId": "A",
          "legendFormat": "{{job}} P50"
        },
        {
          "expr": "(histogram_quantile(0.95, sum by (job, le) (rate(mcp_tool_duration_seconds_bucket[5m]))) > 0) or (sum by (job) (rate(mcp_tool_calls_total[5m])) * 0)",
          "refId": "B",
          "legendFormat": "{{job}} P95"
        },
        {
          "expr": "(histogram_quantile(0.99, sum by (job, le) (rate(mcp_tool_duration_seconds_bucket[5m]))) > 0) or (sum by (job) (rate(mcp_tool_calls_total[5m])) * 0)",
          "refId": "C",
          "legendFormat": "{{job}} P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        }
      }
    },
    {
      "id": 7,
      "title": "Tool Calls by Agent (1h)",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (agent) (increase(mcp_agent_tool_calls_total[1h])))",
          "refId": "A",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      },
      "options": {
        "orientation": "horizontal"
      }
    },
    {
      "id": 8,
      "title": "Tool Error Rate by Tool",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(mcp_tool_calls_total{outcome=\"error\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2
          },
          "noValue": "0",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "scaffold_service Call Rate (10m)",
      "description": "Alert fires when > 5 calls in 10m. Indicates an agent may be creating services in a loop.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "increase(mcp_tool_calls_total{tool=\"scaffold_service\"}[10m])",
          "refId": "A",
          "legendFormat": "scaffold_service (10m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Agent Attribution \u2014 Tool Calls (1h)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (server, tool, agent) (increase(mcp_agent_tool_calls_total[1h])))",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "server": "MCP Server",
              "tool": "Tool",
              "agent": "Agent",
              "Value": "Calls (1h)"
            },
            "excludeByName": {
              "__name__": true,
              "job": true,
              "instance": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Calls (1h)"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Calls (1h)",
            "desc": true
          }
        ]
      }
    }
  ],
  "refresh": "30s",
  "templating": {
    "list": []
  }
}